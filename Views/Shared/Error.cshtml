@model ErrorViewModel
@{
    ViewData["Title"] = "Xeta";
}
<section class="section section--raised smart-section">
    <div class="container text-center reveal">
        <h1 class="display-5">Xəta baş verdi</h1>
        <p class="lead mx-auto">Zəhmət olmasa bir az sonra yenidən cəhd edin.</p>
        @if (Model.ShowRequestId)
        {
            <p><small class="tile__meta">Request ID: @Model.RequestId</small></p>
        }
        <a class="btn btn-brand" asp-controller="Home" asp-action="Index">Ana səhifəyə qayıt</a>
    </div>
</section>
