@model HumayQasimli.Models.ViewModels.NotificationsPageViewModel
@{
    ViewData["Title"] = "Bildirişlər";
}
<section class="section section--raised smart-section">
    <div class="container" style="max-width:640px">
        <h1 class="mb-4 reveal">Bildirişlər</h1>

        <h3 class="mb-3" style="font-size:1.1rem">Oxunmamış (@Model.Unread.Count)</h3>
        <div class="d-flex flex-column gap-2 mb-5">
            @foreach (var n in Model.Unread)
            {
                <div class="tile p-3" style="border-left:3px solid var(--gold)">
                    <a href="@(n.Url ?? "#")" style="color:var(--ink);text-decoration:none">@n.Message</a>
                    <div class="tile__meta mb-2">@n.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                    <div class="d-flex gap-2">
                        <form asp-action="MarkRead" asp-route-id="@n.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-brand">Oxu</button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@n.Id" method="post" onsubmit="return confirm('Silinsin?')">
                            <button type="submit" class="btn btn-sm btn-outline-brand">Sil</button>
                        </form>
                    </div>
                </div>
            }
            @if (!Model.Unread.Any())
            {
                <p class="text-muted">Oxunmamış bildiriş yoxdur.</p>
            }
        </div>

        <h3 class="mb-3" style="font-size:1.1rem">Oxunmuş</h3>
        <div class="d-flex flex-column gap-2">
            @foreach (var n in Model.Read)
            {
                <div class="tile p-3" style="opacity:.7">
                    <a href="@(n.Url ?? "#")" style="color:var(--ink);text-decoration:none">@n.Message</a>
                    <div class="tile__meta mb-2">@n.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                    <form asp-action="Delete" asp-route-id="@n.Id" method="post" onsubmit="return confirm('Silinsin?')">
                        <button type="submit" class="btn btn-sm btn-outline-brand">Sil</button>
                    </form>
                </div>
            }
            @if (!Model.Read.Any())
            {
                <p class="text-muted">Oxunmuş bildiriş yoxdur.</p>
            }
        </div>
    </div>
</section>