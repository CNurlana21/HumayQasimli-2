@model HumayQasimli.Models.ViewModels.PagedResult<MentorMeeting>
@{ ViewData["Title"] = "Mentor görüşləri"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Mentor görüşləri</h1>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus"></i> Yeni</a>
</div>
<form method="get" class="mb-3 col-md-4"><input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Axtar..." /></form>
<table class="table table-bordered bg-white align-middle">
    <thead><tr><th>Başlıq</th><th>Tarix</th><th>Aktiv</th><th></th></tr></thead>
    <tbody>
    @foreach (var m in Model.Items)
    {
        <tr>
            <td>@m.Title</td><td>@m.CreatedAt.ToString("dd.MM.yyyy")</td><td>@(m.IsActive ? "Bəli" : "Xeyr")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Redaktə</a>
                <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm('Silinsin?')"><button type="submit" class="btn btn-sm btn-outline-danger">Sil</button></form>
            </td>
        </tr>
    }
    </tbody>
</table>
