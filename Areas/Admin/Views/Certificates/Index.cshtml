@model HumayQasimli.Models.ViewModels.PagedResult<Certificate>
@{ ViewData["Title"] = "Sertifikatlar"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Sertifikatlar</h1>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus"></i> Yeni</a>
</div>
<form method="get" class="mb-3 col-md-4"><input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Axtar..." /></form>
<table class="table table-bordered bg-white align-middle">
    <thead><tr><th>Şəkil</th><th>Başlıq</th><th>Verən qurum</th><th>Tarix</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Items)
    {
        <tr>
            <td>@if (!string.IsNullOrEmpty(c.ImageUrl)) { <img src="@c.ImageUrl" style="width:60px;height:40px;object-fit:cover" /> }</td>
            <td>@c.Title</td><td>@c.IssuedBy</td><td>@c.IssueDate?.ToString("dd.MM.yyyy")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Redaktə</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Silinsin?')"><button type="submit" class="btn btn-sm btn-outline-danger">Sil</button></form>
            </td>
        </tr>
    }
    </tbody>
</table>
