@model HumayQasimli.Models.ViewModels.PagedResult<Vlog>
@{ ViewData["Title"] = "Vlogs"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Vlogs</h1>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus"></i> Yeni</a>
</div>
<form method="get" class="mb-3 col-md-4">
    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Axtar..." />
</form>
<table class="table table-bordered bg-white align-middle">
    <thead><tr><th>Şəkil</th><th>Başlıq</th><th>Kateqoriya</th><th>Video növü</th><th>Status</th><th>Featured</th><th></th></tr></thead>
    <tbody>
    @foreach (var v in Model.Items)
    {
        <tr>
            <td>@if (!string.IsNullOrEmpty(v.CoverImageUrl)) { <img src="@v.CoverImageUrl" style="width:60px;height:40px;object-fit:cover" /> }</td>
            <td>@v.Title</td>
            <td>@v.Category?.Name</td>
            <td>
                @if (v.VideoSourceType == VideoSourceType.UploadedVideo)
                {
                    <span class="badge bg-info text-dark">Video faylı</span>
                }
                else
                {
                    <span class="badge bg-secondary">Xarici keçid</span>
                }
            </td>
            <td>
                <form asp-action="TogglePublish" asp-route-id="@v.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm @(v.IsPublished ? "btn-success" : "btn-secondary")">@(v.IsPublished ? "Yayımda" : "Gizli")</button>
                </form>
            </td>
            <td>@(v.IsFeatured ? "Bəli" : "-")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Redaktə</a>
                <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline" onsubmit="return confirm('Silinsin?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (Model.TotalPages > 1)
{
    <nav><ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link" href="?page=@i&search=@Model.SearchTerm">@i</a></li>
        }
    </ul></nav>
}
