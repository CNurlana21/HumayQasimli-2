@model HumayQasimli.Models.ViewModels.PagedResult<Media>
@{ ViewData["Title"] = "Media"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Media</h1>
    <a asp-action="Upload" class="btn btn-dark"><i class="bi bi-upload"></i> Yüklə</a>
</div>
<form method="get" class="mb-3 col-md-4"><input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Axtar..." /></form>
<div class="row g-3">
    @foreach (var m in Model.Items)
    {
        <div class="col-md-2 col-4">
            <div class="card">
                @if (m.FileType.StartsWith("image"))
                {
                    <img src="@m.FilePath" class="card-img-top" style="height:100px;object-fit:cover" />
                }
                else
                {
                    <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height:100px"><i class="bi bi-file-earmark-pdf fs-1"></i></div>
                }
                <div class="card-body p-2">
                    <p class="small text-truncate mb-1">@m.FileName</p>
                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" onsubmit="return confirm('Silinsin?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sil</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
