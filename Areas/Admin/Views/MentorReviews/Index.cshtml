@model HumayQasimli.Models.ViewModels.PagedResult<MentorReview>
@{
    ViewData["Title"] = "Mentor rəyləri";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Mentor rəyləri</h1>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus"></i> Yeni</a>
</div>
<form method="get" class="mb-3 col-md-4"><input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Axtar..." /></form>
<table class="table table-bordered bg-white align-middle">
    <thead><tr><th>Ad Soyad</th><th>Status</th><th>Layihə</th><th>Aktiv</th><th>Sıra</th><th></th></tr></thead>
    <tbody>
        @foreach (var r in Model.Items)
        {
            <tr>
                <td>@r.AuthorName</td>
                <td>@r.AuthorTitle</td>
                <td>@r.ProjectName</td>
                <td>@(r.IsActive ? "Bəli" : "Xeyr")</td>
                <td>@r.DisplayOrder</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Redaktə</a>
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Silinsin?')"><button type="submit" class="btn btn-sm btn-outline-danger">Sil</button></form>
                </td>
            </tr>
        }
    </tbody>
</table>