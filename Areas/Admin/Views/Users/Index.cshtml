@model HumayQasimli.Models.ViewModels.PagedResult<ApplicationUser>
@{
    ViewData["Title"] = "İstifadəçilər";
    var roles = ViewBag.Roles as Dictionary<string, IList<string>>;
}
<h1 class="mb-3">İstifadəçilər</h1>
<form method="get" class="mb-3 col-md-4"><input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Ad və ya email ilə axtar..." /></form>
<table class="table table-bordered bg-white align-middle">
    <thead><tr><th>Ad Soyad</th><th>Email</th><th>Rol</th><th>Qeydiyyat</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model.Items)
    {
        <tr>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td>@(roles != null && roles.ContainsKey(u.Id) ? string.Join(", ", roles[u.Id]) : "")</td>
            <td>@u.CreatedAt.ToString("dd.MM.yyyy")</td>
            <td>
                <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Bax</a>
                <form asp-action="ToggleLock" asp-route-id="@u.Id" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-warning">Blokla/Aç</button></form>
                <form asp-action="ToggleAdminRole" asp-route-id="@u.Id" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-primary">Admin rolu</button></form>
                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Silinsin?')"><button type="submit" class="btn btn-sm btn-outline-danger">Sil</button></form>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (Model.TotalPages > 1)
{
    <nav><ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link" href="?page=@i&search=@Model.SearchTerm">@i</a></li> }
    </ul></nav>
}
