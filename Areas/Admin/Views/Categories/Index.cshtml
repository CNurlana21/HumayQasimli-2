@model HumayQasimli.Models.ViewModels.PagedResult<Category>
@{ ViewData["Title"] = "Kateqoriyalar"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Kateqoriyalar</h1>
    <a asp-action="Create" class="btn btn-dark"><i class="bi bi-plus"></i> Yeni</a>
</div>
<form method="get" class="mb-3 col-md-4">
    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Axtar..." />
</form>
<table class="table table-bordered bg-white">
    <thead><tr><th>Ad</th><th>Slug</th><th>Təsvir</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Items)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.Slug</td>
            <td>@c.Description</td>
            <td>
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Redaktə</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Silinsin?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (Model.TotalPages > 1)
{
    <nav><ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")"><a class="page-link" href="?page=@i&search=@Model.SearchTerm">@i</a></li>
        }
    </ul></nav>
}
