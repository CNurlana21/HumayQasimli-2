@model Category
@{ ViewData["Title"] = "Yeni kateqoriya"; }
<h1 class="mb-4">Yeni kateqoriya</h1>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Ad</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Təsvir</label><textarea asp-for="Description" class="form-control"></textarea></div>
    <button type="submit" class="btn btn-dark">Yadda saxla</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
</form>
