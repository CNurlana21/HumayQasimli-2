@model Training
@{ ViewData["Title"] = "Yeni təlim"; }
<h1 class="mb-4">Yeni təlim</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Başlıq</label><input asp-for="Title" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Açıqlama</label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-3"><label class="form-label">Şəkil</label><input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp" /></div>
    <div class="mb-3"><label class="form-label">Tarix</label><input asp-for="StartDate" type="date" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Qeydiyyat linki</label><input asp-for="RegistrationUrl" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" checked /><label class="form-check-label">Aktiv</label></div>
    <button type="submit" class="btn btn-dark">Yadda saxla</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
</form>
